<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jhc.fruit.dao.AIDao">

    <insert id="save" parameterType="java.util.List">
        <if test="detections != null and detections.size() > 0">
            INSERT INTO ai_weed (ai_id, class_id, class_name, confidence, x1, y1, x2, y2)
            VALUES
                <foreach collection="detections"
                         item="item"
                         separator=",">
                    (#{item.aiId}, #{item.classId}, #{item.className}, #{item.confidence}, #{item.x1}, #{item.y1}, #{item.x2}, #{item.y2})
                </foreach>
        </if>
    </insert>
</mapper>