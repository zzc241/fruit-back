<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jhc.fruit.dao.CommentDao">

    <!-- 数据库字段与实体类属性映射 -->
    <resultMap id="CommentResultMap" type="com.jhc.fruit.entity.Comment">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="tree_id" property="treeId"/>
        <result column="orchard_id" property="orchardId"/>
        <result column="content" property="content"/>
        <result column="choice" property="choice"/>
    </resultMap>

    <!-- 查询评论列表 -->
    <select id="selectComments" resultMap="CommentResultMap">
        SELECT id, user_id, tree_id, orchard_id, content, choice
        FROM comment
        <where>
            <if test="userId != null">
                AND user_id = #{userId}
            </if>
            <if test="treeId != null">
                AND tree_id = #{treeId}
            </if>
            <if test="orchardId != null">
                AND orchard_id = #{orchardId}
            </if>
        </where>
        ORDER BY id DESC
        LIMIT #{offset}, #{pageSize}
    </select>

    <!-- 查询评论总数 -->
    <select id="selectCommentCount" resultType="java.lang.Integer">
        SELECT COUNT(1)
        FROM comment
        <where>
            <if test="userId != null">
                AND user_id = #{userId}
            </if>
            <if test="treeId != null">
                AND tree_id = #{treeId}
            </if>
            <if test="orchardId != null">
                AND orchard_id = #{orchardId}
            </if>
        </where>
    </select>
</mapper>