-- ----------------------------
-- Table structure for disaster
-- ----------------------------
DROP TABLE IF EXISTS `disaster`;
CREATE TABLE `disaster`  (
  `id` bigint NOT NULL AUTO_INCREMENT,
  `content` text CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NULL,
  `disaster_type` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NULL DEFAULT NULL COMMENT '灾害类型',
  `user_id` bigint NULL DEFAULT NULL COMMENT '上报人id',
  `orchard_id` bigint NULL DEFAULT NULL COMMENT '果园id',
  `find_time` datetime NULL DEFAULT NULL ON UPDATE CURRENT_TIMESTAMP COMMENT '发现时间',
  `create_time` datetime NULL DEFAULT NULL ON UPDATE CURRENT_TIMESTAMP COMMENT '创建时间',
  `type_id` tinyint NULL DEFAULT NULL COMMENT '灾害大类（1气象，2病害，3虫害)',
  `area_id` bigint NULL DEFAULT NULL,
  PRIMARY KEY (`id`) USING BTREE
) ENGINE = InnoDB AUTO_INCREMENT = 82 CHARACTER SET = utf8mb4 COLLATE = utf8mb4_unicode_ci COMMENT = '灾害表' ROW_FORMAT = Dynamic;

-- ----------------------------
-- Records of disaster
-- ----------------------------
INSERT INTO `disaster` VALUES (2, '灾害预警第二次', '第二个类型', 0, 1, '2026-03-13 09:35:01', '2026-03-13 09:35:01', 1, NULL);
INSERT INTO `disaster` VALUES (3, '🌤️【金华市实时天气】\n天气：晴\n温度：18.0℃\n湿度：28.0%\n风向：西南风 1级\n数据更新时间：2026-03-11 13:10:15\n\n⚠️ 【干旱蓝色预警】\n\n🌱 柑橘种植管理建议：\n• 早晚滴灌浇水，避免大水漫灌；\n• 喷施抗旱剂（黄腐酸钾），提高保水能力；\n• 重点防治红蜘蛛、蚜虫（干旱易爆发）。', NULL, NULL, 1, '2026-03-13 09:35:02', '2026-03-13 09:35:02', 1, NULL);
INSERT INTO `disaster` VALUES (4, '柑橘种植管理建议：\n• 早晚滴灌浇水，避免大水漫灌；\n• 喷施抗旱剂（黄腐酸钾），提高保水能力；\n• 重点防治红蜘蛛、蚜虫（干旱易爆发）。', '干旱蓝色预警', NULL, 1, '2026-03-13 09:35:05', '2026-03-13 09:35:05', 2, NULL);
INSERT INTO `disaster` VALUES (5, '柑橘种植管理建议：\n• 早晚滴灌浇水，避免大水漫灌；\n• 喷施抗旱剂（黄腐酸钾），提高保水能力；\n• 重点防治红蜘蛛、蚜虫（干旱易爆发）。', '干旱蓝色预警', NULL, 1, '2026-03-13 09:35:03', '2026-03-13 09:35:03', 2, NULL);
INSERT INTO `disaster` VALUES (6, '柑橘种植管理建议：\n• 今日天气正常，按计划进行果园巡查；\n• 及时清除病枝病果，预防病虫害；\n• 按周期喷施保护性杀菌剂，常规管理即可。', '气象条件适宜', 13, NULL, NULL, '2026-03-13 21:19:40', 1, NULL);
